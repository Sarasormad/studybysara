# Copy this file to .env (which git ignores) and fill in your own values.
# Never commit .env or paste your key into code or chat.

# Get a key at https://console.anthropic.com/  (Settings -> API keys)
ANTHROPIC_API_KEY=your-key-here

# Optional: which Claude model and effort AI practice uses
# STUDYBYSARA_AI_MODEL=claude-opus-5-5
# STUDYBYSARA_AI_EFFORT=medium

# ---------- Email (optional) ----------
# Without SMTP_HOST, emails are saved as files in instance/outbox/ instead of being sent.
# With a Gmail account, use an App Password (Google Account -> Security -> App passwords),
# never your normal password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# MAIL_FROM=NeuLearning <you@gmail.com>
# The address links in emails point to (your real site once it's deployed):
# APP_BASE_URL=http://localhost:5001
# Set to 0 to stop the dev server from sending reminders in the background:
# NOTIFY_IN_APP=1
